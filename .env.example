# Copy to .env and generate a key as described in README.md.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# A separate database keeps fictional demo records apart from existing data.
DJANGO_DATABASE_PATH=demo.sqlite3
AI_ENABLED=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
